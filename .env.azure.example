
# ---------- Phase 01/02: banco ----------
# Use o hostname do Flexible Server; sslmode=require é obrigatório no Azure.
# O usuário é `tolev_admin` com underscore — o formato `user@servername` era do
# Single Server e falha aqui com "password authentication failed".
SPRING_DATASOURCE_URL=jdbc:postgresql://tolev-pg-zenite.postgres.database.azure.com:5432/tolev?sslmode=require
SPRING_DATASOURCE_USERNAME=tolev_admin
SPRING_DATASOURCE_PASSWORD=

# Gere com: openssl rand -base64 48
# Este valor é permanente. Trocá-lo invalida todo token já emitido e desloga
# todo mundo — por isso ele mora aqui, e não é sorteado a cada deploy.
JWT_SECRET=
JWT_EXPIRATION=86400000

# Sem chave o cliente Gemini se desabilita sozinho e a importação de extrato
# falha com GeminiNaoConfiguradoException.
GEMINI_API_KEY=

# ---------- Phase 03: App Service ----------
# APP_NAME é global no azurewebsites.net: precisa ser único no mundo.
RG=rg-tolev
LOC=brazilsouth
APP_NAME=tolev-api-zenite
PLAN_NAME=plan-tolev
# B1 (~US$13/mês) mantém a aplicação sempre carregada. F1 é grátis, mas dorme
# em 20 min de ociosidade e o cold start do Spring Boot passa de um minuto.
PLAN_SKU=B1
