
# ---------- Phase 01/02: banco ----------
# sslmode=require é obrigatório no Flexible Server.
# O usuário é `tolev_admin`, com underscore.
SPRING_DATASOURCE_URL=jdbc:postgresql://tolev-pg-zenite.postgres.database.azure.com:5432/tolev?sslmode=require
SPRING_DATASOURCE_USERNAME=tolev_admin
SPRING_DATASOURCE_PASSWORD=

# Gere com: openssl rand -base64 48
# Permanente: trocar invalida todo token já emitido.
JWT_SECRET=
JWT_EXPIRATION=86400000

# Sem chave o cliente Gemini se desabilita e a importação de extrato falha.
GEMINI_API_KEY=

# ---------- Phase 03: App Service ----------
# APP_NAME é único em azurewebsites.net.
RG=tolev-pg
LOC=canadacentral
APP_NAME=tolev-api-zenite
PLAN_NAME=plan-tolev
# B1 mantém a aplicação sempre carregada; F1 dorme após 20 min de ociosidade.
PLAN_SKU=B1
